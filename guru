#!/usr/bin/env python3
"""Minimal project selection commands for Guru Agent."""

import argparse
import sys

from memory.sqlite import get_active_project, set_active_project


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="guru")
    commands = parser.add_subparsers(dest="command", required=True)
    project = commands.add_parser("project", help="select or show the active project")
    project_commands = project.add_subparsers(dest="project_command", required=True)
    use = project_commands.add_parser("use", help="select a Git repository")
    use.add_argument("path")
    project_commands.add_parser("show", help="show the active Git repository")
    args = parser.parse_args(argv)

    if args.project_command == "use":
        try:
            selected = set_active_project(args.path)
        except (OSError, ValueError) as error:
            print(str(error), file=sys.stderr)
            return 2
        print(f"Active project: {selected}")
        return 0

    selected = get_active_project()
    if selected is None:
        print("No active project selected.", file=sys.stderr)
        return 1
    print(f"Active project: {selected}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
